#!/usr/bin/env bash
# Builds (if needed -- cargo's own freshness check is a fast no-op once nothing has changed) and
# runs target/release/arena: self-play, the gate, matches and tournaments. Release-only, since
# performance actually matters at self-play's scale. No libtorch dependency, so no environment
# variables to set here (unlike bin/smithy), and it runs on every generating machine. `cd`s to
# the repo root before running: the opening book, the Syzygy directories, data/engines.yaml, and
# every game's output paths are all relative to the repo root.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# `stop` and `status` only talk to the running arena over 127.0.0.1, so they skip the build: Windows
# refuses to replace an arena.exe that is running, and the build would fail before the stop ever
# reached it.
case "${1:-}" in
    stop | status) control=1 ;;
    *) control=0 ;;
esac
if [ "$control" = 0 ] || [ ! -f "$REPO_ROOT/target/release/arena.exe" ]; then
    # kalo-chess too: every timed match spawns target/release/kalo-chess as a UCI engine, directly rather than
    # through bin/kalo-chess, so it must be as fresh as the arena itself.
    cargo build --release --bin arena --bin kalo-chess
fi
exec "$REPO_ROOT/target/release/arena.exe" "$@"
