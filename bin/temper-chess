#!/usr/bin/env bash
# Builds (if needed -- cargo's own freshness check is a fast no-op once nothing has changed) and
# runs target/release/temper-chess. No libtorch dependency, so no environment variables to set here
# (unlike bin/smithy). Exists purely so every binary in this repo can be invoked the same way,
# without needing .bashrc or a sourced venv first. Safe for a UCI GUI to launch directly despite the
# build step: cargo's own compile/progress/error output goes to stderr, never stdout, so it can
# never be mistaken for a UCI protocol message.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

cargo build --release --bin temper-chess
exec "$REPO_ROOT/target/release/temper-chess.exe" "$@"
